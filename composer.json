{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pars-design/grow4me-laravel-data-connector",
    "description": "Expose Laravel products and custom data through Grow4Me's versioned sync contract.",
    "keywords": [
        "grow4me",
        "laravel",
        "data-integration",
        "sync",
        "webhook"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Pars Design",
            "homepage": "https://pars.design"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "ParsDesign\\Grow4MeDataConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ParsDesign\\Grow4MeDataConnector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ParsDesign\\Grow4MeDataConnector\\Grow4MeDataConnectorServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "format": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
